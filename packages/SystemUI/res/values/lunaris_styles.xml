<resources>
     <!-- Tri-state UI -->
    <style name="qs_theme" parent="Theme.SystemUI.QuickSettings">
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- Data usage -->
    <style name="TextAppearance.QS.Status.DataUsage">
        <item name="android:textColor">?attr/onSurfaceVariant</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
    </style>
    
    <!-- Status bar notification ticker -->
    <style name="TextAppearance.StatusBar.PhoneTicker" parent="@*android:style/TextAppearance.StatusBar">
        <!-- Note: must be dp to fit in status bar -->
        <item name="android:textSize">14.0sp</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
    </style>
</resources>
